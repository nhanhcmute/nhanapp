{
  "name": "nhanapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "start:frontend": "npm start --prefix frontend",
    "start:backend": "dotnet run --project backend/backend.csproj",
    "start": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm:start:frontend\" \"npm:start:backend\"",
    "dev": "npm run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
